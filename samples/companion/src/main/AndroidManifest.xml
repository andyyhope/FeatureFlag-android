<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The host's bridge permission. Without it the host is invisible, and the companion says to add this. -->
    <!-- region snippet: sample-companion-uses-permission -->
    <uses-permission android:name="${hostId}.permission.FEATURE_FLAG_BRIDGE" />
    <!-- endregion -->

    <application
        android:label="Flags"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".CompanionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
